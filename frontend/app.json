{
  "expo": {
    "version": "0.1.0",
    "scheme": "medifind",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow MediFind to take a prescription photo for local preview.",
          "microphonePermission": false,
          "photosPermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MediFind to find your barangay in Cagayan de Oro when you tap Use my location.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "name": "MediFind",
    "userInterfaceStyle": "light",
    "slug": "medicine-search-ordering",
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "output": "single"
    }
  }
}
