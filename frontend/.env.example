# Optional API override. Unset: web uses localhost; native development uses the Expo LAN host.
# For a tunnel or separate backend, set the reachable backend URL explicitly.
# EXPO_PUBLIC_API_URL=http://192.168.1.5:8000
# Optional Photon-compatible geocoder. The default demo service is for modest prototype traffic.
EXPO_PUBLIC_GEOCODER_URL=https://photon.komoot.io/api/
